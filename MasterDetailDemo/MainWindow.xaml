<Window x:Class="MasterDetailDemo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Пользователи"
        Width="850"
        Height="420"
        MinWidth="750"
        MinHeight="380"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="25" />
            <ColumnDefinition Width="2*" />
        </Grid.ColumnDefinitions>

        <!-- Master: список пользователей -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Text="Список пользователей"
                       FontSize="20"
                       Margin="0,0,0,15" />

            <ListView x:Name="UserListView"
                      Grid.Row="1"
                      ItemsSource="{Binding Users}"
                      SelectedIndex="0"
                      SelectionMode="Single">

                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Имя"
                                        Width="100"
                                        DisplayMemberBinding="{Binding Name}" />

                        <GridViewColumn Header="Email"
                                        Width="200"
                                        DisplayMemberBinding="{Binding Email}" />

                        <GridViewColumn Header="Возраст"
                                        Width="65"
                                        DisplayMemberBinding="{Binding Age}" />
                    </GridView>
                </ListView.View>
            </ListView>
        </Grid>

        <!-- Detail: данные выбранного пользователя -->
        <StackPanel Grid.Column="2"
                    DataContext="{Binding SelectedItem,
                                          ElementName=UserListView}">

            <TextBlock Text="Данные пользователя"
                       FontSize="20"
                       Margin="0,0,0,15" />

            <TextBlock Text="Имя:" />

            <TextBox Text="{Binding Name,
                                    Mode=TwoWay,
                                    UpdateSourceTrigger=PropertyChanged}"
                     FontSize="16"
                     Margin="0,5,0,15" />

            <TextBlock Text="Email:" />

            <TextBox Text="{Binding Email,
                                    Mode=TwoWay,
                                    UpdateSourceTrigger=PropertyChanged}"
                     FontSize="16"
                     Margin="0,5,0,15" />

            <TextBlock Text="Возраст:" />

            <TextBox x:Name="AgeTextBox"
                     Text="{Binding Age,
                                    Mode=TwoWay,
                                    UpdateSourceTrigger=PropertyChanged,
                                    ValidatesOnExceptions=True}"
                     FontSize="16"
                     Margin="0,5,0,0" />

            <TextBlock Text="Введите целое число."
                       Foreground="Red"
                       Margin="0,5,0,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility"
                                Value="Collapsed" />

                        <Style.Triggers>
                            <DataTrigger
                                Binding="{Binding ElementName=AgeTextBox,
                                                  Path=(Validation.HasError)}"
                                Value="True">

                                <Setter Property="Visibility"
                                        Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <TextBlock Text="Изменения сразу отображаются в списке."
                       TextWrapping="Wrap"
                       Foreground="Gray"
                       Margin="0,20,0,0" />
        </StackPanel>
    </Grid>
</Window>